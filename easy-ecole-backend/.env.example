# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# JWT Secret (REQUIRED - generate a random string)
JWT_SECRET=change_this_to_a_random_secret_key
DB_SYNC_ON_BOOT=false
DISABLE_BOOT_ORPHAN_PURGE=true

# CORS Origin (REQUIRED - frontend URL)
CORS_ORIGIN=http://localhost:4200

# Database (optional - defaults to sequelize.json in dev)
# En conteneur Docker, DB_HOST DOIT valoir `db` (nom du service compose)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=easyecole
DB_USER=easyecole_app
DB_PASS=replace_with_a_strong_password
# SSL : "off" pour Docker/local sans TLS, "require" pour production avec TLS
DB_SSL=off

# EMAIL (transactional sending)
# Mode API Brevo (RECOMMENDED): simple API key + verified sender, no SMTP server.
# Takes priority over SMTP as soon as BREVO_API_KEY is set.
BREVO_API_KEY=
# Verified sender in Brevo (fallback: account's default verified sender)
MAIL_FROM=
BREVO_FROM=

# SMTP mode (legacy - only used if BREVO_API_KEY is not set)
# SMTP_HOST=
# SMTP_PORT=465
# Avec un relais transactionnel (Brevo, Resend...), SMTP_USER est une cle API
# (ex. Xsmtpsib-...). L'adresse d'expediteur (From) est alors definie par
# MAIL_FROM : une adresse VERIFIEE dans le relais (ex. no-reply@votre-domaine).
# SMTP_USER=
# SMTP_PASS=

# SSL (optional - for HTTPS)
SSL_KEY=
SSL_CERT=

# Encryption (optional - auto-generated if not set)
# 64 hex chars = 32 bytes for AES-256 master key
ENCRYPTION_MASTER_KEY=

# Cinetpay (Mobile Money) - optional
CINETPAY_API_KEY=
CINETPAY_MERCHANT_ID=
CINETPAY_BASE_URL=https://api.cinetpay.com/v1

# SMS AfrikSMS (optional; numbers are read from aut_utilisateurs.contact)
# ClientId + ApiKey fournis par AfrikSMS ; SenderId = 11 caracteres max (doit etre autorise)
SMS_AFRIKSMS_CLIENT_ID=
SMS_AFRIKSMS_API_KEY=
SMS_AFRIKSMS_SENDER_ID=
SMS_AFRIKSMS_BASE_URL=https://api.afriksms.com

# WhatsApp Cloud API (optional; use E.164 phone numbers)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
