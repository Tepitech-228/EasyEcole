# =============================================================================
# EasyEcole - Variables PRODUCTION (Dokploy / VM APP)
#
# Copier ces variables dans Dokploy (onglet Environment) ou dans un fichier
# .env local NON versionne. Ne jamais committer de secrets reels.
# =============================================================================

# --- Base de donnees EXTERNE (VM DB) ---
DB_HOST=192.168.100.20
DB_PORT=3306
DB_NAME=easyecole
DB_USER=easyecole_app
DB_PASS=change-me
DB_SSL=off

# --- Secrets applicatifs ---
JWT_SECRET=change-me
DOCGEN_SECRET=change-me
ENCRYPTION_MASTER_KEY=
CORS_ORIGIN=http://192.168.100.10:8080

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Redis / execution ---
REDIS_URL=redis://redis:6379
TZ=UTC
MIGRATIONS_ON_BOOT=true
DB_BOOTSTRAP_SCHEMA=true

# --- Stockage documentaire ---
# Documents importes : uploads/<annee>/<type>/<sous-type?>/
# Documents generes  : created/<annee>/<type>/<sous-type?>/
DOCUMENTS_HOST_PATH=/mnt/easyecole-documents
BACKUP_STORAGE_HOST_PATH=/mnt/easyecole-storage
PUBLIC_HOST_PATH=/mnt/easyecole-documents/uploads/_legacy/public
UPLOADS_HOST_PATH=/mnt/easyecole-documents/created/_legacy/pv
STORAGE_HOST_PATH=/mnt/easyecole-documents/created/_legacy/storage
CONFIG_HOST_PATH=/opt/mon-app/config
KEYS_HOST_PATH=/opt/mon-app/keys
DOCUMENTS_STORAGE_DIR=/app/documents
TMP_DIR=/tmp/easyecole
# Vide = annee academique calculee automatiquement (bascule au 1er septembre).
ACADEMIC_YEAR=
# Initialisation automatique du stockage (service init-storage) :
# derniere annee pre-creee (2050 => 2050-2051).
ACADEMIC_YEAR_UNTIL=2050
# Premiere annee de la plage (les annees en base/dossiers existants sont
# ajoutees individuellement).
ACADEMIC_YEAR_FROM=2025-2026
# Annees supplementaires explicites (facultatif), ex. :
# ACADEMIC_YEARS=2023-2024 2024-2025 2025-2026
ACADEMIC_YEARS=
# true = refuser de demarrer si les marqueurs .easyecole-mounted sont absents.
REQUIRE_DOCUMENTS_MOUNT=true

# --- Sauvegardes ---
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# ON si la base externe a GTID active ; sinon OFF.
BACKUP_SET_GTID_PURGED=ON
BACKUP_RUN_ONCE=false

# --- Frontend ---
FRONTEND_PORT=8080

# --- Pointage Hikvision (push des terminaux) ---
# Port publie sur l'hote -> 3000 (conteneur). URL terminal :
#   http://192.168.100.10:8000/api/hikvision/event
# Ne pas modifier PORT (healthcheck + proxy nginx utilisent 3000).
HIKVISION_PORT=8000
# Interface d'ecoute sur l'hote (0.0.0.0 = toutes). Restreindre via firewall.
HIKVISION_BIND_IP=0.0.0.0

# --- Droits des montages ---
# true = si les montages refusent l'ecriture en uid 1000, demarrer le backend
# en root au lieu de boucler. Deblocage temporaire : repasser a false apres
# correction des droits cote hote (chown ou options de montage).
ALLOW_ROOT_FALLBACK=true
