# =============================================================================
# EasyEcole — configuration MySQL 8.0 du noeud MASTER (conteneur `db`)
# -----------------------------------------------------------------------------
# Objectif : activer le binary log + GTID pour la replication vers le MySQL
# installe sur WS22 (replica lecture seule).
#
# IMPORTANT :
#   - Faire un dump complet AVANT le premier redemarrage avec cette config.
#   - Redemarrer le conteneur db pour appliquer : docker compose up -d db
#   - Verifier ensuite : SHOW VARIABLES LIKE 'log_bin'; SHOW MASTER STATUS;
# =============================================================================

[mysqld]
# Identifiant unique du noeud master (le replica WS22 doit avoir server-id=2).
server-id = 1

# Binary log : indispensable pour la replication.
log_bin = mysql-bin
binlog_format = ROW
binlog_row_image = FULL

# Purge automatique des binlogs apres 7 jours (604800 secondes).
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M

# GTID : simplifie la bascule et la reprise du replica.
gtid_mode = ON
enforce_gtid_consistency = ON

# Durabilite : le binlog est synchronise a chaque transaction.
# Cout acceptable pour une base de taille moderee ; retirer si I/O trop fortes.
sync_binlog = 1
