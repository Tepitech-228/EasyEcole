# =============================================================================
# EasyEcole — variables de stockage WS22 et de replication MySQL
# -----------------------------------------------------------------------------
# A fusionner dans l'environnement du serveur (Dokploy ou .env de production).
# Ne contient AUCUN secret : les mots de passe restent dans l'environnement
# du serveur / le gestionnaire de secrets.
#
# Les chemins ci-dessous sont les points de montage CIFS du partage WS22
# sur la VM Linux (voir /etc/fstab). Ils doivent exister avant le demarrage.
# =============================================================================

# --- Montages CIFS (hote Linux) ---
APPLICATION_HOST_PATH=/data/application
PUBLIC_HOST_PATH=/data/application/public
UPLOADS_HOST_PATH=/data/application/uploads
STORAGE_HOST_PATH=/data/application/storage
DOCUMENTS_HOST_PATH=/data/documents
BACKUPS_HOST_PATH=/data/backups
TMP_HOST_PATH=/opt/mon-app/tmp
CONFIG_HOST_PATH=/opt/mon-app/config
KEYS_HOST_PATH=/opt/mon-app/keys

# --- Garde-fou : refuse le demarrage si un montage WS22 manque ---
REQUIRE_WS22_MOUNT=true

# --- Copie quotidienne du dump SQL vers WS22 (Sauvegardes) ---
BACKUP_OFFSITE_DIR=/backups/offsite

# --- Replication MySQL : port 3306 publie uniquement sur l'interface privee ---
# Remplacer par l'IP de la VM Linux sur le reseau 192.168.100.0/24.
DB_REPLICATION_BIND=192.168.100.10
